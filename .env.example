# ==============================================================================
# TraceMesh: Example Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to .env and fill in your real Supabase credentials.
# cp .env.example .env
# ==============================================================================

# Supabase Database Connections
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
DIRECT_DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Supabase API Credentials
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key-here"
SUPABASE_ANON_KEY="your-supabase-anon-publishable-key-here"

# Application Settings
API_TOKEN="tracemesh-hackathon-token-2026"
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"
APP_ENV="demo"
LOG_LEVEL="INFO"

# Pipeline & Dataset Settings
ACTIVE_DATASET="demo"
DATASET_DIR="./data"
PIPELINE_CONFIG_PATH="./detection/config/thresholds.json"

# Optional LLM Rewriter
LLM_API_KEY=""
LLM_MODEL="gemini-1.5-flash"

